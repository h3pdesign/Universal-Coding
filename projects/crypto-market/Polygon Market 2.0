"""
Polygon MATIC Probability Tracker (Upgraded Version)
----------------------------------------------------
Features:
- Fetches MATIC, BTC, ETH 90-day historical prices (CoinGecko API)
- Calculates correlations
- Adds TVL, active addresses, fees (DeFiLlama + PolygonScan APIs)
- Adds developer metrics (GitHub API)
- Adds technical indicators (RSI, price ratios)
- Adds macro crypto indicators (Fear & Greed, BTC Dominance)
"""

import requests
import pandas as pd
import numpy as np
from datetime import datetime, timedelta

# --------------------
# API Endpoints
# --------------------
COINGECKO_API = "https://api.coingecko.com/api/v3"
DEFI_LLAMA_API = "https://api.llama.fi"
ALTERNATIVE_API = "https://api.alternative.me/fng/"
GITHUB_API = "https://api.github.com/repos"

# --------------------
# Helper: Fetch 90-day market data
# --------------------
def get_price_history(coin_id, days=90):
    url = f"{COINGECKO_API}/coins/{coin_id}/market_chart"
    params = {"vs_currency": "usd", "days": days, "interval": "daily"}
    r = requests.get(url, params=params).json()
    prices = pd.DataFrame(r["prices"], columns=["timestamp", "price"])
    prices["date"] = pd.to_datetime(prices["timestamp"], unit="ms").dt.date
    return prices[["date", "price"]]

# --------------------
# Helper: RSI Calculation
# --------------------
def calculate_rsi(prices, period=14):
    delta = prices.diff()
    gain = delta.clip(lower=0).rolling(window=period).mean()
    loss = -delta.clip(upper=0).rolling(window=period).mean()
    rs = gain / loss
    return 100 - (100 / (1 + rs))

# --------------------
# Developer Activity
# --------------------
def get_github_dev_activity(owner, repo):
    # NOTE: May require GitHub personal token for higher rate limits
    url = f"{GITHUB_API}/{owner}/{repo}/stats/commit_activity"
    r = requests.get(url).json()
    if not isinstance(r, list):
        return None
    commits_last_4_weeks = sum([week["total"] for week in r[-4:]])
    return commits_last_4_weeks

# --------------------
# On-chain Data (placeholders for PolygonScan API)
# --------------------
def get_polygon_active_addresses():
    # Placeholder: Replace with PolygonScan API or Nansen query
    # Example: https://api.polygonscan.com/api?module=stats&action=dailytxnfee
    return 626000  # last known live metric

# --------------------
# Macro Indicators
# --------------------
def get_fear_greed():
    r = requests.get(ALTERNATIVE_API).json()
    return int(r["data"][0]["value"])

def get_btc_dominance():
    url = f"{COINGECKO_API}/global"
    r = requests.get(url).json()
    return r["data"]["market_cap_percentage"]["btc"]

# --------------------
# Main Function
# --------------------
def main():
    # 1. Price histories
    matic = get_price_history("polygon")
    btc = get_price_history("bitcoin")
    eth = get_price_history("ethereum")

    # Merge for correlations
    df = matic.merge(btc, on="date", suffixes=("_matic", "_btc"))
    df = df.merge(eth, on="date")
    df.rename(columns={"price": "price_eth"}, inplace=True)

    corr_btc = df["price_matic"].corr(df["price_btc"])
    corr_eth = df["price_matic"].corr(df["price_eth"])

    # 2. RSI
    rsi = calculate_rsi(df["price_matic"]).iloc[-1]

    # 3. Dev Activity
    commits = get_github_dev_activity("maticnetwork", "polygon-edge")  # Example repo

    # 4. TVL from DeFiLlama
    tvl_url = f"{DEFI_LLAMA_API}/v2/historicalChainTvl/Polygon"
    tvl_data = requests.get(tvl_url).json()
    tvl_latest = tvl_data[-1]["totalLiquidityUSD"]

    # 5. Macro
    fear_greed = get_fear_greed()
    btc_dom = get_btc_dominance()

    # 6. Scoring system
    metrics = {
        "Price (USD)": matic["price_matic"].iloc[-1],
        "TVL": tvl_latest,
        "Active Addresses": get_polygon_active_addresses(),
        "BTC Correlation": corr_btc,
        "ETH Correlation": corr_eth,
        "RSI": rsi,
        "Commits (4w)": commits,
        "Fear & Greed": fear_greed,
        "BTC Dominance": btc_dom
    }

    # Normalize & weight (example weights)
    weights = {
        "TVL": 0.15,
        "Active Addresses": 0.10,
        "BTC Correlation": 0.10,
        "ETH Correlation": 0.05,
        "RSI": 0.10,
        "Commits (4w)": 0.15,
        "Fear & Greed": 0.10,
        "BTC Dominance": 0.10,
        "Price (USD)": 0.05
    }

    # Simple normalization: score = value percentile
    df_norm = {}
    for k, v in metrics.items():
        if k in ["BTC Correlation", "ETH Correlation"]:
            score = v  # already 0-1 scale
        elif k == "RSI":
            score = 1 - abs(50 - v) / 50  # mid RSI is neutral, extremes bad
        elif k == "Fear & Greed":
            score = 1 - abs(50 - v) / 50
        elif k == "BTC Dominance":
            score = 1 - (v / 100)  # lower dominance better for alts
        elif isinstance(v, (int, float)):
            score = min(v / (max(v, 1) * 2), 1)  # crude scaling
        else:
            score = 0.5
        df_norm[k] = score

    weighted_score = sum(df_norm[k] * weights[k] for k in weights)

    # Probability mapping
    prob_2025 = weighted_score * 0.45
    prob_2026 = weighted_score * 0.85

    print("---- Polygon MATIC Tracker ----")
    print(pd.Series(metrics))
    print("\nNormalized Scores:", df_norm)
    print(f"\nWeighted Bullishness Score: {weighted_score:.2f}")
    print(f"Probability >=50% gains by end-2025: {prob_2025:.0%}")
    print(f"Probability >=50% gains in 2026: {prob_2026:.0%}")

if __name__ == "__main__":
    main()